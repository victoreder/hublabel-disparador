      },
      "id": "d1d2d3d4-0009-4000-8000-000000000009",
      "name": "DADOS CONEXAO PHONE",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [720, 300],
      "credentials": {
        "supabaseApi": { "id": "yzLw3CRWlDo2pmsj", "name": "Supabase [SAAS]" }
      }
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "SAAS_Conexões",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "contaId",
              "keyValue": "={{ $('VALIDAR ENTRADA').item.json.contaId }}"
            },
            {
              "keyName": "apiOficial",
              "keyValue": "true"
            }
          ]
        }
      },
      "id": "d1d2d3d4-0010-4000-8000-000000000010",
      "name": "DADOS CONEXOES CONTA",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [720, 440],
      "credentials": {
        "supabaseApi": { "id": "yzLw3CRWlDo2pmsj", "name": "Supabase [SAAS]" }
      }
    },
    {
      "parameters": {
        "jsCode": "const entrada = $('VALIDAR ENTRADA').first().json;\nconst items = $input.all().map((item) => item.json).filter((row) => row && row.id);\n\nconst sanitize = (row) => {\n  if (!row) return null;\n  const { metaPinVerificacao, ...semPin } = row;\n  if (!entrada.incluir_token) {\n    const { access_token, Apikey, ...safe } = semPin;\n    return safe;\n  }\n  return semPin;\n};\n\nconst conexoes = entrada.modo === 'conta'\n  ? items.map(sanitize)\n  : items.length ? [sanitize(items[0])] : [];\n\nreturn [\n  {\n    json: {\n      ok: true,\n      total: conexoes.length,\n      conexoes\n    }\n  }\n];"
      },
      "id": "d1d2d3d4-0005-4000-8000-000000000005",
      "name": "MONTAR RESPOSTA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": { "responseCode": 200 }
      },
      "id": "d1d2d3d4-0006-4000-8000-000000000006",
      "name": "RESPONDER SUCESSO",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "content": "## Body de entrada (POST)\n\n```json\n{ \"conexaoId\": 123 }\n```\n\n```json\n{ \"phone_number_id\": \"123456789\" }\n```\n\n```json\n{ \"contaId\": \"uuid-conta\" }\n```\n\nOpcional:\n```json\n{ \"conexaoId\": 123, \"incluir_token\": true }\n```\n\nConsulta direto em `SAAS_Conexões` (filtro `apiOficial=true` quando por conta).\nCredencial: Supabase [SAAS]\n\nURL: POST https://n8n2.victoreder.com.br/webhook/meta-consultar-conexao",
        "height": 400,
        "width": 520
      },
      "id": "d1d2d3d4-0007-4000-8000-000000000007",
      "name": "NOTAS",
