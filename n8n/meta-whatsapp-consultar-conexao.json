{
  "name": "Meta WhatsApp - Consultar Conexao",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meta-consultar-conexao",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d1d2d3d4-0001-4000-8000-000000000001",
      "name": "WEBHOOK CONSULTAR CONEXAO",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "meta-consultar-conexao"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body ?? raw;\n\nconst conexaoId = body.conexaoId || body.conexao_id || null;\nconst phoneNumberId = body.phone_number_id || null;\nconst contaId = body.contaId || body.conta_id || null;\nconst incluirToken = body.incluir_token === true;\n\nif (!conexaoId && !phoneNumberId && !contaId) {\n  throw new Error('Informe conexaoId, phone_number_id ou contaId.');\n}\n\nlet modo = 'conta';\nif (conexaoId) modo = 'id';\nelse if (phoneNumberId) modo = 'phone';\n\nreturn [{ json: { conexaoId, phone_number_id: phoneNumberId, contaId, incluir_token: incluirToken, modo } }];"
      },
      "id": "d1d2d3d4-0003-4000-8000-000000000003",
      "name": "VALIDAR ENTRADA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.modo }}",
                    "rightValue": "id",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "por_id"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.modo }}",
                    "rightValue": "phone",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "por_phone"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "d1d2d3d4-0008-4000-8000-000000000008",
      "name": "MODO CONSULTA",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "tableId": "SAAS_Conexões",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "keyValue": "={{ $('VALIDAR ENTRADA').item.json.conexaoId }}"
            }
          ]
        }
      },
      "id": "d1d2d3d4-0004-4000-8000-000000000004",
      "name": "DADOS CONEXAO ID",
