PORT=3000

# Credenciais do app Meta/Facebook
FACEBOOK_APP_ID=SEU_APP_ID
FACEBOOK_APP_SECRET=SEU_APP_SECRET

# URI exata cadastrada no app da Meta
META_REDIRECT_URI=https://auth.hublabel.com.br/oauth/meta/callback

# Chave para assinar state (min. 32 chars)
STATE_SECRET=troque-por-uma-chave-forte-com-32-ou-mais-caracteres

# Lista de origins permitidas (separadas por virgula)
ALLOWED_RETURN_ORIGINS=https://cliente-a.com,https://app.cliente-b.com

# Escopos da Meta (ajuste conforme sua necessidade)
META_OAUTH_SCOPES=whatsapp_business_management,whatsapp_business_messaging

# Tempo de expiração do state em segundos
STATE_TTL_SECONDS=600
