# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_aqui
# Anon key pública — vai para as telas (login/consultas do navegador)
SUPABASE_ANON_KEY=sua_anon_key_aqui

# Evolution API (src/workers/evolution.js)
EVOLUTION_BASE_URL=https://evolution2.victoreder.com.br
EVOLUTION_API_KEY=sua-apikey-global-evolution

# Inbound — única URL que muda por cliente/deploy
BACK_URL=https://webhook2.victoreder.com.br

# Agente IA
REDIS_URL=redis://redis:6379

# S3 (mídias Meta)
S3_ENDPOINT=https://s32.victoreder.com.br
S3_ACCESS_KEY_ID=sua_access_key
S3_SECRET_ACCESS_KEY=sua_secret_key
S3_PUBLIC_BASE_URL=https://s32.victoreder.com.br/n8n

# Telas/ações (opcionais)
# PLANO_GRATIS_ID=2
# PLANO_GRATIS_DIAS=2
# SENHA_PADRAO_INTEGRACAO=Padrao123456
# OPENAI_MODEL_PAGINA_VENDAS=gpt-5.3-codex
# UPLOAD_MAX_FILE_BYTES=104857600
# TZ_SISTEMA=America/Sao_Paulo
