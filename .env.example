PORT=3000

# Credenciais do app Meta/Facebook
FACEBOOK_APP_ID=26865081006452696
FACEBOOK_APP_SECRET=SEU_APP_SECRET

# URI exata cadastrada no app da Meta
META_REDIRECT_URI=https://auth.hublabel.com.br/oauth/meta/callback

# Chave para assinar state e assinar POST ao whitelabel (min. 32 chars)
STATE_SECRET=troque-por-uma-chave-forte-com-32-ou-mais-caracteres

# Opcional: restrinja origins (vazio = aceita qualquer http/https valido)
# ALLOWED_RETURN_ORIGINS=https://cliente-a.com,https://app.cliente-b.com

# embedded (padrao, App Review WhatsApp) ou classic (dialog/oauth)
META_OAUTH_MODE=embedded

# Escopos usados no modo classic
META_OAUTH_SCOPES=whatsapp_business_management,whatsapp_business_messaging,business_management

# WhatsApp Embedded Signup
META_CONFIG_ID=1464159071696114

# Endpoint POST no whitelabel: {return_origin}/api/meta/conectar
META_WHITELABEL_CONNECT_PATH=/api/meta/conectar

# Tempo de expiração do state em segundos
STATE_TTL_SECONDS=600

# Versao Graph API
META_GRAPH_API_VERSION=v21.0
