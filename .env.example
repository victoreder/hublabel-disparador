# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_aqui
# Anon key pública — vai para as telas (login/consultas do navegador)
SUPABASE_ANON_KEY=sua_anon_key_aqui

# Evolution API (src/workers/evolution.js)
EVOLUTION_BASE_URL=https://evolution2.victoreder.com.br
EVOLUTION_API_KEY=sua-apikey-global-evolution

# Inbound — única URL que muda por cliente/deploy
BACK_URL=https://webhook2.victoreder.com.br

# Agente IA
REDIS_URL=redis://redis:6379

# S3 (mídias Meta)
S3_ENDPOINT=https://s32.victoreder.com.br
S3_ACCESS_KEY_ID=sua_access_key
S3_SECRET_ACCESS_KEY=sua_secret_key
S3_PUBLIC_BASE_URL=https://s32.victoreder.com.br/n8n

# Telas/ações (opcionais)
# PLANO_GRATIS_ID=2
# PLANO_GRATIS_DIAS=2
# SENHA_PADRAO_INTEGRACAO=Padrao123456
# OPENAI_MODEL_PAGINA_VENDAS=gpt-5.3-codex
# UPLOAD_MAX_FILE_BYTES=52428800
# TZ_SISTEMA=America/Sao_Paulo

# Segurança das ações
# HUB_API_KEY=chave-longa-aleatoria   # header x-api-key = super admin (integrações sem tela)
# CADASTRO_GRATIS_ATIVO=true
# CADASTRO_GRATIS_LIMITE_HORA=5        # cadastros grátis por IP/hora
# WEBHOOK_ENTRADA_LIMITE_MINUTO=120    # /token e /integracao por IP/minuto
# TESTE_EMAIL_LIMITE_HORA=20           # e-mails de teste por usuário/hora

# Login (POST /auth/login)
# LOGIN_MAX_FALHAS=5                   # senhas erradas por e-mail...
# LOGIN_JANELA_MIN=15                  # ...nesta janela → bloqueia o e-mail
# LOGIN_BLOQUEIO_MIN=15
# LOGIN_LIMITE_IP_MINUTO=10

# Jail ("fail2ban" da aplicação)
# JAIL_LIMITE_PONTOS=30                # pontos por IP na janela → ban
# JAIL_JANELA_MIN=10
# JAIL_BAN_MIN=60
# SEGURANCA_IPS_LIBERADOS=1.2.3.4,5.6.7.8   # nunca limitados/banidos (rede interna já é)
# CLIENT_IP_HEADER=cf-connecting-ip    # só se houver Cloudflare na frente

# Limites e sobrecarga
# API_LIMITE_MINUTO=300                # requisições por IP/min (webhooks Meta/Evolution ficam fora)
# IA_LIMITE_MINUTO=10                  # chamadas de IA por usuário/min
# IA_CONCORRENCIA=4                    # chamadas de IA simultâneas no servidor
# UPLOAD_LIMITE_MINUTO=30
# UPLOAD_CONCORRENCIA=3
# SOBRECARGA_LAG_MS=250                # acima disso recusa (503) o que não é essencial
# CORS_ORIGENS=https://outro-dominio.com

# Licença (obrigatória na imagem Docker distribuída; ignorada rodando do fonte)
LICENCA_EMAIL=email-da-compra@exemplo.com
